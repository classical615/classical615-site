# Copy this file to ".env.local" and fill in your real values.
# Never share this file or paste these values anywhere public.

# Your Airtable API key (Airtable calls this a "Personal Access Token").
# Get it at https://airtable.com/create/tokens
# It needs "data.records:read" access to your Classical 615 base.
AIRTABLE_API_KEY=

# Your base ID — found in the Airtable API docs for your base, or in the
# base's URL: airtable.com/appXXXXXXXXXXXXXX/...  (the "appXXXX..." part)
AIRTABLE_BASE_ID=

# The exact name of your Events table (as it appears in Airtable).
AIRTABLE_EVENTS_TABLE=Events

# The exact name of the view that only shows approved, public-ready events.
AIRTABLE_PUBLIC_VIEW=Approved / Public
